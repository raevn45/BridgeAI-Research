modules = ["python-3.12", "web", "nodejs-20"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
HOST = "0.0.0.0"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "test"
mode = "sequential"
author = 63374757

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python test_api.py"

[[workflows.workflow]]
name = "time"
mode = "sequential"
author = 63374757

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "gunicorn --bind 0.0.0.0:5000 --timeout 120 app:app"

[[workflows.workflow]]
name = "gunicorn"
mode = "sequential"
author = 63374757

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install gunicorn"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "app:app"]
healthcheckPath = "/healthz"
